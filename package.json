{
  "name": "kecare-monorepo",
  "private": true,
  "scripts": {
    "gen": "bun run ./projects/generator/index.ts gen \"projects/theme\"",
    "clean": "bun run ./projects/generator/index.ts clean \"projects/theme\"",
    "dev": "bun run ./projects/generator/index.ts dev \"projects/theme\" --with-nuxt",
    "test": "bun run ./projects/test/run.ts",
    "build": "bun run --filter kecare-theme build",
    "check": "bun run ./projects/generator/index.ts check \"projects/theme\""
  },
  "workspaces": [
    "projects/*",
    "packages/*",
    ".commands"
  ],
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/supabase-js": "^2.111.0",
    "@types/node": "^25.2.2",
    "@vueuse/core": "^14.2.1",
    "consola": "^3.4.2",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "marked-katex-extension": "^5.1.6",
    "modern-normalize": "^3.0.1",
    "oh-my-logo": "^0.5.0",
    "openai": "^6.17.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "latest",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0"
  },
  "version": "1.0.0-beta.124"
}